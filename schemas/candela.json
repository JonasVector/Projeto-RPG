{
  "system": "candela",
  "version": "1.1",
  "displayName": "Candela Obscura",
  "_source": "Candela Obscura — Darrington Press (2023), sistema Illuminated Worlds. Inclui ficha do Investigador (character) e ficha do Círculo (circle) — grupo de investigadores, com patrono, tarot e ações iluminantes.",
  "character": {
    "identity": {
      "title": "Identidade",
      "fields": {
        "nome": { "type": "string", "required": true, "label": "Nome" },
        "papel": {
          "type": "string",
          "required": true,
          "label": "Papel",
          "options": ["Face", "Músculo", "Erudito", "Sombra", "Estranho"]
        },
        "especialidade": { "type": "string", "required": true, "label": "Especialidade" },
        "estilo": { "type": "string", "required": false, "label": "Estilo" },
        "antecedente": { "type": "string", "required": false, "label": "Antecedente" }
      }
    },
    "drives": {
      "title": "Impulsos",
      "fields": {
        "nervo": { "type": "number", "min": 0, "max": 3, "label": "Nervo (Nerve)", "defaultValue": 0 },
        "astucia": { "type": "number", "min": 0, "max": 3, "label": "Astúcia (Cunning)", "defaultValue": 0 },
        "intuicao": { "type": "number", "min": 0, "max": 3, "label": "Intuição (Intuition)", "defaultValue": 0 }
      }
    },
    "actions": {
      "title": "Ações",
      "fields": {
        "mover": { "type": "number", "min": 0, "max": 4, "label": "Mover (Nervo)", "defaultValue": 0 },
        "atacar": { "type": "number", "min": 0, "max": 4, "label": "Atacar (Nervo)", "defaultValue": 0 },
        "controlar": { "type": "number", "min": 0, "max": 4, "label": "Controlar (Nervo)", "defaultValue": 0 },
        "persuadir": { "type": "number", "min": 0, "max": 4, "label": "Persuadir (Astúcia)", "defaultValue": 0 },
        "ler": { "type": "number", "min": 0, "max": 4, "label": "Ler (Astúcia)", "defaultValue": 0 },
        "esconder": { "type": "number", "min": 0, "max": 4, "label": "Esconder (Astúcia)", "defaultValue": 0 },
        "investigar": { "type": "number", "min": 0, "max": 4, "label": "Investigar (Intuição)", "defaultValue": 0 },
        "focar": { "type": "number", "min": 0, "max": 4, "label": "Focar (Intuição)", "defaultValue": 0 },
        "sentir": { "type": "number", "min": 0, "max": 4, "label": "Sentir / Arcano (Intuição)", "defaultValue": 0 }
      }
    },
    "vitalities": {
      "title": "Vitalidades (Marcas)",
      "fields": {
        "corpo_marcas": { "type": "number", "min": 0, "max": 3, "label": "Corpo (Body)", "defaultValue": 0 },
        "mente_marcas": { "type": "number", "min": 0, "max": 3, "label": "Mente (Brain)", "defaultValue": 0 },
        "sangue_marcas": { "type": "number", "min": 0, "max": 3, "label": "Sangramento (Bleed)", "defaultValue": 0 },
        "resistencia_corpo": { "type": "number", "min": 0, "max": 4, "label": "Resistência Corpo", "defaultValue": 0 },
        "resistencia_mente": { "type": "number", "min": 0, "max": 4, "label": "Resistência Mente", "defaultValue": 0 },
        "resistencia_sangue": { "type": "number", "min": 0, "max": 4, "label": "Resistência Sangramento", "defaultValue": 0 }
      }
    },
    "gilded": {
      "title": "Dourado / Cicatrizes",
      "fields": {
        "dados_dourados": { "type": "number", "min": 0, "max": 3, "label": "Dados Dourados (Gilded)", "defaultValue": 0 },
        "queimar": { "type": "number", "min": 0, "max": 6, "label": "Queimar (Burn)", "defaultValue": 0 },
        "cicatrizes": { "type": "array", "items": { "type": "string" }, "label": "Cicatrizes" }
      }
    },
    "abilities": {
      "title": "Habilidades de Especialidade",
      "fields": {
        "habilidades": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "nome": { "type": "string" },
              "descricao": { "type": "string" },
              "ativa": { "type": "boolean" }
            }
          },
          "label": "Habilidades"
        }
      }
    },
    "equipment": {
      "title": "Equipamento",
      "fields": {
        "itens": { "type": "array", "items": { "type": "string" }, "label": "Itens" },
        "memento": { "type": "string", "label": "Memento" }
      }
    },
    "background": {
      "title": "História",
      "fields": {
        "historia": { "type": "string", "label": "História do Investigador" },
        "vinculos": { "type": "string", "label": "Vínculos com o Círculo" },
        "notas": { "type": "string", "label": "Notas" }
      }
    }
  },
  "circle": {
    "identity": {
      "title": "Identidade do Círculo",
      "fields": {
        "nome_circulo": { "type": "string", "required": true, "label": "Nome do Círculo" },
        "lema": { "type": "string", "required": false, "label": "Lema / Motto" },
        "sede": { "type": "string", "required": false, "label": "Sede / Localização" },
        "era": { "type": "string", "required": false, "label": "Era / Cidade (ex.: Newfaire)" }
      }
    },
    "patron": {
      "title": "Patrono",
      "fields": {
        "patrono_nome": { "type": "string", "label": "Nome do Patrono" },
        "patrono_natureza": {
          "type": "string",
          "label": "Natureza",
          "options": ["Humano", "Entidade Arcana", "Organização", "Facção", "Outro"]
        },
        "patrono_descricao": { "type": "textarea", "label": "Descrição e agenda" }
      }
    },
    "tarot": {
      "title": "Tarot do Círculo",
      "fields": {
        "arcana": {
          "type": "string",
          "label": "Arcano",
          "options": [
            "O Louco", "O Mago", "A Sacerdotisa", "A Imperatriz", "O Imperador",
            "O Hierofante", "Os Amantes", "A Carruagem", "A Força", "O Eremita",
            "A Roda da Fortuna", "A Justiça", "O Enforcado", "A Morte", "A Temperança",
            "O Diabo", "A Torre", "A Estrela", "A Lua", "O Sol",
            "O Julgamento", "O Mundo"
          ]
        },
        "significado": { "type": "textarea", "label": "Significado para o Círculo" }
      }
    },
    "roster": {
      "title": "Investigadores",
      "fields": {
        "membros": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "nome": { "type": "string" },
              "papel": { "type": "string" },
              "jogador": { "type": "string" }
            }
          },
          "label": "Membros"
        }
      }
    },
    "illuminating_actions": {
      "title": "Ações Iluminantes",
      "_notes": "As Illuminating Actions do Círculo representam as capacidades coletivas. Os 6 campos abaixo (3 Investigação + 3 Preparação) são pontuações de 0 a 3 conforme o livro.",
      "fields": {
        "investigar_arcano": { "type": "number", "min": 0, "max": 3, "label": "Investigar — Arcano", "defaultValue": 0 },
        "investigar_social": { "type": "number", "min": 0, "max": 3, "label": "Investigar — Social", "defaultValue": 0 },
        "investigar_academico": { "type": "number", "min": 0, "max": 3, "label": "Investigar — Acadêmico", "defaultValue": 0 },
        "preparar_armas": { "type": "number", "min": 0, "max": 3, "label": "Preparar — Armas", "defaultValue": 0 },
        "preparar_ritual": { "type": "number", "min": 0, "max": 3, "label": "Preparar — Ritual", "defaultValue": 0 },
        "preparar_disfarce": { "type": "number", "min": 0, "max": 3, "label": "Preparar — Disfarce", "defaultValue": 0 }
      }
    },
    "resources": {
      "title": "Recursos",
      "fields": {
        "contatos": { "type": "array", "items": { "type": "object", "properties": { "nome": { "type": "string" }, "papel": { "type": "string" }, "notas": { "type": "string" } } }, "label": "Contatos" },
        "ativos": { "type": "array", "items": { "type": "string" }, "label": "Ativos (propriedades, equipamentos do círculo)" },
        "dividas": { "type": "array", "items": { "type": "string" }, "label": "Dívidas e obrigações" }
      }
    },
    "horrors": {
      "title": "Horrores e Nêmeses",
      "fields": {
        "inimigos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "nome": { "type": "string" },
              "tipo": { "type": "string" },
              "status": { "type": "string", "options": ["Ativo", "Derrotado", "Fugiu", "Desconhecido"] },
              "notas": { "type": "string" }
            }
          },
          "label": "Nêmeses"
        }
      }
    },
    "progress": {
      "title": "Progresso do Círculo",
      "fields": {
        "reputacao": { "type": "number", "min": 0, "max": 10, "label": "Reputação", "defaultValue": 0 },
        "casos_encerrados": { "type": "number", "min": 0, "label": "Casos Encerrados", "defaultValue": 0 },
        "casos_abertos": { "type": "array", "items": { "type": "string" }, "label": "Casos em Aberto" },
        "notas": { "type": "textarea", "label": "Notas do Círculo" }
      }
    }
  }
}
